{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ossgamebench:phase3:generation-output:v2-proposed",
  "title": "Phase 3C proposed generated test scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": ["bug_id", "scenarios"],
  "properties": {
    "bug_id": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/scenario_s1"},
        {"$ref": "#/$defs/scenario_s2"},
        {"$ref": "#/$defs/scenario_s3"}
      ],
      "items": false
    }
  },
  "$defs": {
    "string_array": {"type": "array", "items": {"type": "string"}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "action"],
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "action": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
        }
      }
    },
    "scenario_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id", "preconditions", "environment_assumptions",
        "trigger_conditions", "ordered_execution_steps",
        "expected_observable_behavior", "test_oracle",
        "uncertainty_or_unsupported_assumptions"
      ],
      "properties": {
        "scenario_id": {"type": "string"},
        "preconditions": {"$ref": "#/$defs/string_array"},
        "environment_assumptions": {"$ref": "#/$defs/string_array"},
        "trigger_conditions": {"$ref": "#/$defs/string_array"},
        "ordered_execution_steps": {"$ref": "#/$defs/steps"},
        "expected_observable_behavior": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "test_oracle": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "uncertainty_or_unsupported_assumptions": {"$ref": "#/$defs/string_array"}
      }
    },
    "scenario_s1": {"allOf": [{"$ref": "#/$defs/scenario_base"}, {"properties": {"scenario_id": {"const": "S1"}}}]},
    "scenario_s2": {"allOf": [{"$ref": "#/$defs/scenario_base"}, {"properties": {"scenario_id": {"const": "S2"}}}]},
    "scenario_s3": {"allOf": [{"$ref": "#/$defs/scenario_base"}, {"properties": {"scenario_id": {"const": "S3"}}}]}
  }
}
