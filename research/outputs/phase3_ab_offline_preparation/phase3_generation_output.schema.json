{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ossgamebench:phase3:generation-output:v1",
  "title": "Phase 3 generated test scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": ["bug_id", "scenarios"],
  "properties": {
    "bug_id": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id", "preconditions", "environment_assumptions",
          "trigger_conditions", "ordered_execution_steps",
          "expected_observable_behavior", "test_oracle",
          "uncertainty_or_unsupported_assumptions"
        ],
        "properties": {
          "scenario_id": {"type": "string", "pattern": "^S[1-3]$"},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "environment_assumptions": {"type": "array", "items": {"type": "string"}},
          "trigger_conditions": {"type": "array", "items": {"type": "string"}},
          "ordered_execution_steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["step", "action"],
              "properties": {
                "step": {"type": "integer", "minimum": 1},
                "action": {"type": "string", "minLength": 1}
              }
            }
          },
          "expected_observable_behavior": {"type": "string", "minLength": 1},
          "test_oracle": {"type": "string", "minLength": 1},
          "uncertainty_or_unsupported_assumptions": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
